_zshai_provider_sse_filter() {
  awk '
BEGIN {
  checked = 0; is_tool = 0; buf = ""; in_think = 0;
}
function extract_str(line, key) {
  idx = index(line, "\"" key "\":");
  if (idx <= 0) return "";
  rem = substr(line, idx + length(key) + 2);
  sub(/^[[:space:]]+/, "", rem);
  if (substr(rem, 1, 1) != "\"") return "";
  str = ""; len = length(rem);
  for (i = 2; i <= len; i++) {
    c = substr(rem, i, 1);
    if (c == "\\" && i < len) {
      nc = substr(rem, i + 1, 1);
      if (nc == "\"") { str = str "\""; i++; continue; }
      if (nc == "n") { str = str "\n"; i++; continue; }
      if (nc == "\\") { str = str "\\"; i++; continue; }
    }
    if (c == "\"") break;
    str = str c;
  }
  return str;
}
/^data: / {
  sub(/^data: /, "");
  if ($0 == "[DONE]") exit;

  th = extract_str($0, "reasoning_content");
  if (th == "") th = extract_str($0, "thinking");
  if (th != "") {
    if (!in_think) {
      printf "\033[2m" > "/dev/stderr";
      in_think = 1;
    }
    printf "%s", th > "/dev/stderr";
    fflush("/dev/stderr");
  }

  ct = extract_str($0, "content");
  if (ct != "") {
    if (in_think) {
      printf "\033[0m\n" > "/dev/stderr";
      in_think = 0;
    }
    if (!checked) {
      buf = buf ct;
      trimmed = buf;
      sub(/^[[:space:]]+/, "", trimmed);
      if (substr(trimmed, 1, 7) == "{\"name\"" || substr(trimmed, 1, 7) == "{\"type\"" || substr(trimmed, 1, 11) == "<tool_call>" || substr(trimmed, 1, 7) == "```json") {
        is_tool = 1; checked = 1;
      } else if (length(trimmed) >= 15 || index(trimmed, "\n") > 0) {
        is_tool = 0; checked = 1;
        printf "%s", buf > "/dev/stderr"; fflush("/dev/stderr");
      }
    } else {
      if (!is_tool) {
        printf "%s", ct > "/dev/stderr"; fflush("/dev/stderr");
      }
    }
  }
}
END {
  if (in_think) printf "\033[0m\n" > "/dev/stderr";
  if (!checked && !is_tool) {
    trimmed = buf;
    sub(/^[[:space:]]+/, "", trimmed);
    if (substr(trimmed, 1, 7) != "{\"name\"" && substr(trimmed, 1, 11) != "<tool_call>") {
      printf "%s", buf > "/dev/stderr";
    }
  }
}'
}

_zshai_provider_reconstruct_sse() {
  local sse_raw="$1"
  jq -R -s -c '
    [split("\n")[] | select(startswith("data: ")) | .[6:] | select(. != "[DONE]") | fromjson? ] as $events |
    ([$events[] | .choices[0].delta.content // empty] | join("")) as $content |
    ([$events[] | .choices[0].delta.reasoning_content // .choices[0].delta.thinking // empty] | join("")) as $reasoning |
    ([$events[] | .choices[0].delta.tool_calls // empty | .[]] ) as $raw_calls |
    (if ($raw_calls | length) > 0 then
      ($raw_calls | group_by(.index) | map({
        id: (map(.id // empty) | first // "call_0"),
        type: "function",
        function: {
          name: (map(.function.name // empty) | first // ""),
          arguments: ([map(.function.arguments // empty)[]] | join(""))
        }
      }))
    else
      []
    end) as $tool_calls |
    (if ($tool_calls | length) == 0 and ($content | length) > 0 and (($content | sub("^\\s+"; "") | (startswith("{\"name\"") or startswith("{\"type\"") or startswith("<tool_call>") or startswith("```json"))) | not) then true else false end) as $was_streamed |
    {
      streamed: $was_streamed,
      choices: [{
        message: (
          {role: "assistant"} +
          (if ($tool_calls | length) > 0 then {tool_calls: $tool_calls} else {} end) +
          (if ($content | length) > 0 then {content: $content} else {} end) +
          (if ($reasoning | length) > 0 then {reasoning_content: $reasoning} else {} end)
        )
      }]
    }
  ' "$sse_raw" 2>/dev/null
}

_zshai_provider_call() {
  local history_json="$1"
  local tools_json="$2"

  autoload -Uz _zshai_config _zshai_config_get _zshai_adapters 2>/dev/null
  if ! (($+functions[_zshai_adapter_resolve])); then
    _zshai_adapters check >/dev/null 2>&1 || true
  fi

  local base_url api_key model timeout raw_max_tokens thinking
  base_url="$(_zshai_config_get base_url)"
  api_key="$(_zshai_config_get api_key)"
  model="$(_zshai_config_get model)"
  timeout="$(_zshai_config_get timeout)"
  raw_max_tokens="$(_zshai_config_get max_tokens)"
  thinking="$(_zshai_config_get thinking)"

  local adapter
  adapter=$(_zshai_adapter_resolve "$base_url" "$model")

  local cap_fn="_zshai_adapter_${adapter}_cap"
  (($+functions[$cap_fn])) || cap_fn="_zshai_adapter_generic_cap"
  local max_tokens
  max_tokens=$($cap_fn "$model" "$raw_max_tokens")

  local payload_fn="_zshai_adapter_${adapter}_payload"
  (($+functions[$payload_fn])) || payload_fn="_zshai_adapter_generic_payload"
  local payload
  payload=$($payload_fn "$model" "$history_json" "$tools_json" "$max_tokens" "$thinking" "$base_url")

  if [[ -n "$ZSHAI_MOCK_PROVIDER" ]]; then
    print -r -- "$payload" | eval "$ZSHAI_MOCK_PROVIDER"
    return $?
  fi

  local url="${base_url%/}"
  [[ "$url" != *"/chat/completions" ]] && url="${url}/chat/completions"

  local stream_mode
  stream_mode="$(_zshai_config_get stream)"
  local should_stream=0
  if [[ "$stream_mode" == "1" ]] && [[ -t 1 || -n "$ZSHAI_FORCE_STREAM" ]]; then
    should_stream=1
  fi

  if ((should_stream == 1)); then
    payload=$(print -r -- "$payload" | jq -c '. + {stream: true}')
    local sse_raw
    sse_raw=$(mktemp)
    trap "rm -f \"$sse_raw\"" EXIT INT TERM

    curl -N -sS -X POST "$url" \
      -H "Content-Type: application/json" \
      -H "Authorization: Bearer ${api_key}" \
      --max-time "${timeout}" \
      -d "$payload" 2>&1 | tee "$sse_raw" | _zshai_provider_sse_filter
    local curl_exit=$?
    if ((curl_exit != 0)) || [[ ! -s "$sse_raw" ]]; then
      return 1
    fi

    local err_msg
    err_msg=$(jq -r '.error.message // empty' "$sse_raw" 2>/dev/null)
    if [[ -n "$err_msg" ]]; then
      print -u2 -- "Error: $err_msg"
      return 1
    fi

    local reconstructed
    reconstructed=$(_zshai_provider_reconstruct_sse "$sse_raw")
    if [[ -n "$reconstructed" ]]; then
      print -r -- "$reconstructed"
      return 0
    fi
    return 1
  fi

  local resp_file
  resp_file=$(mktemp)
  trap "rm -f \"$resp_file\"" EXIT INT TERM

  local curl_out
  curl_out=$(curl -sS -o "$resp_file" -w "%{http_code}" -X POST "$url" \
    -H "Content-Type: application/json" \
    -H "Authorization: Bearer ${api_key}" \
    --max-time "${timeout}" \
    -d "$payload" 2>&1)
  local curl_exit=$?

  if ((curl_exit != 0)); then
    print -u2 -- "Error: API request failed: $curl_out"
    return 1
  fi

  local http_code="$curl_out"
  if [[ "$http_code" != "200" ]]; then
    local err_msg
    err_msg=$(jq -r '.error.message // .message // empty' "$resp_file" 2>/dev/null)
    [[ -z "$err_msg" ]] && err_msg=$(<"$resp_file")
    print -u2 -- "Error: HTTP $http_code: $err_msg"
    return 1
  fi

  local err_msg
  err_msg=$(jq -r '.error.message // empty' "$resp_file" 2>/dev/null)
  if [[ -n "$err_msg" ]]; then
    print -u2 -- "Error: $err_msg"
    return 1
  fi

  cat "$resp_file"
}

_zshai_provider() {
  local cmd="${1:-call}"
  shift
  case "$cmd" in
    call)
      _zshai_provider_call "$@"
      ;;
    *)
      print -u2 -- "Usage: _zshai_provider call <history_json> [tools_json]"
      return 1
      ;;
  esac
}

_zshai_provider "$@"
