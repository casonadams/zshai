_zshai_tool_bash() {
  case "$1" in
    describe)
      print -r -- "- bash: Execute a shell command in a dedicated subshell and capture its output and exit code"
      ;;
    definition)
      cat <<'EOF'
{"type":"function","function":{"name":"bash","description":"Execute a shell command in a dedicated subshell and capture its output and exit code.","parameters":{"type":"object","properties":{"command":{"type":"string","description":"The shell command to execute."}},"required":["command"]}}}
EOF
      ;;
    exec)
      local cmd
      if [[ "$2" == [[:space:]]*\{* || "$2" == \{* ]]; then
        cmd=$(print -r -- "$2" | jq -r '.command // empty' 2>/dev/null)
      fi
      [[ -z "$cmd" ]] && cmd="$2"
      _zshai_tool_bash "$cmd"
      ;;
    *)
      local cmd="$1" output="" exit_code=0 log_dir="${TMPDIR:-/tmp}/zshai" log_file=""
      mkdir -p -m 0700 "$log_dir" 2>/dev/null
      log_file=$(mktemp "${log_dir}/bash-XXXXXX" 2>/dev/null || mktemp "${TMPDIR:-/tmp}/bash-XXXXXX" 2>/dev/null)
      if [[ -n "$log_file" ]]; then
        mv "$log_file" "${log_file}.log" 2>/dev/null && log_file="${log_file}.log"
        chmod 0600 "$log_file" 2>/dev/null
      fi
      (eval "$cmd") >"${log_file:-/dev/null}" 2>&1
      exit_code=$?
      output="$(cat "$log_file" 2>/dev/null)"
      if ((exit_code != 0)); then
        output="$(printf "%s\n[Process exited with code %d]" "${output:-}" "$exit_code")"
        [[ -n "$log_file" ]] && print -r -- "[Process exited with code $exit_code]" >>"$log_file"
      fi
      local max_lines="${ZSHAI_BASH_MAX_LINES:-50}"
      local -a out_lines
      out_lines=("${(@f)output}")
      if ((${#out_lines} <= max_lines)); then
        [[ -n "$log_file" ]] && rm -f "$log_file"
        _zshai_truncate "$output" "$max_lines"
      else
        _zshai_truncate "$output" "$max_lines" "$log_file"
      fi
      ;;
  esac
}

_zshai_tool_read() {
  case "$1" in
    describe)
      print -r -- "- read: Read file contents with line numbering (start_line and limit safeguards)"
      ;;
    definition)
      cat <<'EOF'
{"type":"function","function":{"name":"read","description":"Read file contents with line numbers and optional line range bounding.","parameters":{"type":"object","properties":{"path":{"type":"string","description":"Path to the file to read."},"start_line":{"type":"integer","description":"1-based starting line number (default 1)."},"limit":{"type":"integer","description":"Maximum number of lines to read (default 200)."}},"required":["path"]}}}
EOF
      ;;
    exec)
      local file_path start_line limit
      file_path=$(print -r -- "$2" | jq -r '.path // empty')
      start_line=$(print -r -- "$2" | jq -r '.start_line // 1')
      limit=$(print -r -- "$2" | jq -r '.limit // 200')
      _zshai_tool_read "$file_path" "$start_line" "$limit"
      ;;
    *)
      local file_path="$1"
      local start_line="${2:-1}"
      local limit="${3:-200}"

      [[ ! -e "$file_path" ]] && {
        print -r -- "Error: file not found: $file_path"
        return 0
      }
      [[ -d "$file_path" ]] && {
        print -r -- "Error: $file_path is a directory"
        return 0
      }
      [[ ! -r "$file_path" ]] && {
        print -r -- "Error: file not readable: $file_path"
        return 0
      }
      [[ ! -s "$file_path" ]] && {
        print -r -- "(empty file)"
        return 0
      }
      [[ "$(file -b --mime-encoding "$file_path" 2>/dev/null)" == "binary" ]] && {
        print -r -- "Error: file appears to be binary: $file_path"
        return 0
      }

      local end_line=$((start_line + limit - 1))
      local result
      result="$(awk -v start="$start_line" -v end="$end_line" 'NR >= start && NR <= end { printf "%d: %s\n", NR, $0 }' "$file_path")"
      if [[ -z "$result" ]]; then
        print -r -- "(no content at specified lines)"
      else
        _zshai_truncate "$result"
      fi
      ;;
  esac
}

_zshai_tool_write() {
  case "$1" in
    describe)
      print -r -- "- write: Create or overwrite files atomically (automatically creates parent directories)"
      ;;
    definition)
      cat <<'EOF'
{"type":"function","function":{"name":"write","description":"Create or overwrite a file with specified content.","parameters":{"type":"object","properties":{"path":{"type":"string","description":"Path to the file to write."},"content":{"type":"string","description":"Full file content to write."}},"required":["path","content"]}}}
EOF
      ;;
    exec)
      local file_path content
      file_path=$(print -r -- "$2" | jq -r '.path // empty')
      content=$(print -r -- "$2" | jq -r '.content // empty')
      _zshai_tool_write "$file_path" "$content"
      ;;
    *)
      local file_path="$1"
      local content="$2"

      [[ -z "$file_path" ]] && {
        print -r -- "Error: write requires path"
        return 1
      }

      local dir="${file_path:h}"
      [[ -n "$dir" && "$dir" != "." ]] && { mkdir -p "$dir" || {
        print -r -- "Error: failed to create directory: $dir"
        return 1
      }; }

      local tmp="${file_path}.tmp.$$"
      trap "rm -f \"$tmp\"" EXIT INT TERM

      printf "%s" "$content" >"$tmp" || {
        print -r -- "Error: failed to write to $tmp"
        return 1
      }
      mv -f "$tmp" "$file_path" || {
        print -r -- "Error: failed to replace $file_path"
        return 1
      }

      local bytes
      bytes=$(wc -c <"$file_path" | tr -d ' ')
      print -r -- "Successfully wrote $bytes bytes to $file_path"
      ;;
  esac
}

_zshai_tool_edit() {
  case "$1" in
    describe)
      print -r -- "- edit: Make precise file edits with exact search-and-replace (old_text must match uniquely)"
      ;;
    definition)
      cat <<'EOF'
{"type":"function","function":{"name":"edit","description":"Perform exact search-and-replace on an existing file.","parameters":{"type":"object","properties":{"path":{"type":"string","description":"Path to the file to edit."},"old_text":{"type":"string","description":"The exact existing text to replace (must match uniquely)."},"new_text":{"type":"string","description":"The replacement text."}},"required":["path","old_text","new_text"]}}}
EOF
      ;;
    exec)
      local file_path old_text new_text
      file_path=$(print -r -- "$2" | jq -r '.path // empty')
      old_text=$(print -r -- "$2" | jq -r '.old_text // empty')
      new_text=$(print -r -- "$2" | jq -r '.new_text // empty')
      _zshai_tool_edit "$file_path" "$old_text" "$new_text"
      ;;
    *)
      local file_path="$1"
      local old_text="$2"
      local new_text="$3"

      [[ ! -e "$file_path" ]] && {
        print -r -- "Error: file not found: $file_path"
        return 0
      }
      [[ -d "$file_path" ]] && {
        print -r -- "Error: $file_path is a directory"
        return 0
      }
      [[ ! -r "$file_path" || ! -w "$file_path" ]] && {
        print -r -- "Error: file not readable/writable: $file_path"
        return 0
      }

      local content="$(
        <"$file_path"
        printf x
      )"
      content="${content%x}"

      local -a split_parts
      split_parts=("${(@ps:$old_text:)content}")

      if ((${#split_parts} == 1)); then
        print -r -- "Error: old_text not found in $file_path"
        return 0
      fi

      if ((${#split_parts} > 2)); then
        local count=$((${#split_parts} - 1))
        print -r -- "Error: old_text is ambiguous ($count matches in $file_path); provide more surrounding context"
        return 0
      fi

      local result="${split_parts[1]}${new_text}${split_parts[2]}"
      local tmp="${file_path}.tmp.$$"
      trap "rm -f \"$tmp\"" EXIT INT TERM

      printf "%s" "$result" >"$tmp" || {
        print -r -- "Error: failed to write to temporary file"
        return 1
      }
      mv -f "$tmp" "$file_path" || {
        print -r -- "Error: failed to update $file_path"
        return 1
      }

      print -r -- "Successfully replaced text in $file_path"
      ;;
  esac
}

_zshai_tool_websearch() {
  case "$1" in
    describe)
      print -r -- "- websearch: Search the web via DuckDuckGo Lite for documentation, APIs, and current information"
      ;;
    definition)
      cat <<'EOF'
{"type":"function","function":{"name":"websearch","description":"Search the web using DuckDuckGo Lite. Returns titles, URLs, and snippets.","parameters":{"type":"object","properties":{"query":{"type":"string","description":"The search query string."},"limit":{"type":"integer","description":"Maximum number of results to return (default: 5, max: 10)."}},"required":["query"]}}}
EOF
      ;;
    exec)
      local query limit
      query=$(print -r -- "$2" | jq -r '.query // empty')
      limit=$(print -r -- "$2" | jq -r '.limit // 5')
      _zshai_tool_websearch "$query" "$limit"
      ;;
    *)
      local query="$1"
      local limit="${2:-5}"

      [[ -z "$query" ]] && {
        print -r -- "Error: query cannot be empty"
        return 0
      }

      ((limit < 1)) && limit=1
      ((limit > 10)) && limit=10

      local html
      html="$(curl -s -G -A "Lynx/2.9.3 libwww-FM/2.14 SSL-MM/1.4.1 OpenSSL/4.0.0" \
        --max-time 15 \
        --data-urlencode "q=$query" \
        "https://lite.duckduckgo.com/lite/" 2>/dev/null)"

      if [[ -z "$html" ]]; then
        print -r -- "Error: failed to retrieve search results (network or timeout error)"
        return 0
      fi

      local parsed
      parsed="$(print -r -- "$html" | awk -v limit="$limit" '
function clean(s) {
  gsub(/<[^>]*>/, "", s)
  gsub(/&amp;/, "\\&", s)
  gsub(/&#x27;/, "\047", s)
  gsub(/&quot;/, "\"", s)
  gsub(/&lt;/, "<", s)
  gsub(/&gt;/, ">", s)
  gsub(/&nbsp;/, " ", s)
  gsub(/\t/, " ", s)
  gsub(/^[ \t\r\n]+|[ \t\r\n]+$/, "", s)
  return s
}
function extract_url(href) {
  if (match(href, /uddg=[^&"\047 ]+/)) {
    return substr(href, RSTART + 5, RLENGTH - 5)
  }
  return ""
}
BEGIN { count = 0; in_snippet = 0; snippet = "" }
/class=[\047"]result-link[\047"]/ {
  if (count >= limit) exit
  href = ""
  if (match($0, /href=[\047"][^\047"]+[\047"]/)) {
    href = substr($0, RSTART + 6, RLENGTH - 7)
  }
  title = clean($0)
  url = extract_url(href)
  if (url != "" && title != "") {
    count++
    titles[count] = title
    urls[count] = url
  }
}
/class=[\047"]result-snippet[\047"]/ {
  if (count > 0 && count <= limit) {
    in_snippet = count
    snippet = clean($0)
    if ($0 ~ /<\/td>/) {
      snippets[in_snippet] = snippet
      in_snippet = 0
    }
  }
}
!/class=[\047"]result-snippet[\047"]/ && in_snippet > 0 {
  snippet = snippet " " clean($0)
  if ($0 ~ /<\/td>/) {
    snippets[in_snippet] = clean(snippet)
    in_snippet = 0
  }
}
END {
  for (i = 1; i <= count; i++) {
    printf "%s\t%s\t%s\n", titles[i], urls[i], snippets[i]
  }
}
')"

      if [[ -z "$parsed" ]]; then
        print -r -- "No search results found for: $query"
        return 0
      fi

      local out=""
      local idx=1
      local title enc_url snippet rep url
      while IFS=$'\t' read -r title enc_url snippet; do
        [[ -z "$title" ]] && continue
        rep="${enc_url//\%/\\x}"
        url="$(printf '%b' "$rep")"
        out+="${idx}. [${title}](${url})"$'\n'
        [[ -n "$snippet" ]] && out+="   ${snippet}"$'\n'
        ((idx++))
      done <<<"$parsed"

      local res="${out%$'\n'}"
      _zshai_truncate "$res"
      ;;
  esac
}

_zshai_tools_list() {
  if [[ -n "$ZSHAI_ACTIVE_TOOLS" ]]; then
    print -r -- "$ZSHAI_ACTIVE_TOOLS"
    return 0
  fi
  local ws="${ZSHAI_WEBSEARCH:-1}"
  if [[ "$ws" == "0" ]]; then
    print -r -- "bash read write edit"
  else
    print -r -- "bash read write edit websearch"
  fi
}

_zshai_tools_definitions() {
  local -a defs
  local name fn
  for name in ${=$(_zshai_tools_list)}; do
    fn="_zshai_tool_${name}"
    (($+functions[$fn])) && defs+=("$($fn definition)")
  done
  printf "%s\n" "${defs[@]}" | jq -s -c .
}

_zshai_tools_exec() {
  local tool_name="${(L)1}"
  local args_json="$2"

  local safe_mode="$(_zshai_config_get safe_mode 2>/dev/null || echo 0)"
  if [[ "$safe_mode" == "1" ]]; then
    case "$tool_name" in
      bash | write | edit)
        print -u2 -- "[safe_mode] About to execute $tool_name with arguments:"
        print -u2 -- "$args_json"
        print -n -u2 -- "Allow execution? [y/N]: "
        local answer
        read -r answer
        if [[ "$answer" != [yY]* ]]; then
          print -r -- "Error: tool execution cancelled by user (safe_mode)"
          return 0
        fi
        ;;
    esac
  fi

  local fn="_zshai_tool_${tool_name}"
  if ! (($+functions[$fn])); then
    print -r -- "Error: unknown tool: $tool_name"
    return 0
  fi

  $fn exec "$args_json"
}

_zshai_tools() {
  (($# == 0)) && return 0
  local cmd="$1"
  shift
  case "$cmd" in
    definitions) _zshai_tools_definitions "$@" ;;
    exec) _zshai_tools_exec "$@" ;;
    list) _zshai_tools_list "$@" ;;
    *)
      print -u2 "Usage: _zshai_tools <definitions|exec <tool> <json>|list>"
      return 1
      ;;
  esac
}

_zshai_tools "$@"
