_zshai_context_instructions() {
  local global="$1" project="$2" root="$3"
  [[ -z "$global" && -z "$project" ]] && return 0

  print -r -- ""
  print -r -- "<project_context>"
  if [[ -n "$global" && -r "$global" ]]; then
    print -r -- "<global_instructions path=\"~/.agents/AGENTS.md\">"
    cat "$global"
    print -r -- "</global_instructions>"
  fi
  if [[ -n "$project" && -r "$project" ]]; then
    local rel="${project#$root/}"
    print -r -- "<project_instructions path=\"${rel:-$project:t}\">"
    cat "$project"
    print -r -- "</project_instructions>"
  fi
  print -r -- "</project_context>"
}

_zshai_context() {
  autoload -Uz _zshai_tools 2>/dev/null
  _zshai_tools list >/dev/null 2>&1 || true
  local repo_root
  repo_root="$(git rev-parse --show-toplevel 2>/dev/null)" || repo_root="$PWD"

  local global_agents="" project_agents="" cand
  for cand in "${HOME}/.agents/AGENTS.md" "${HOME}/.config/agents/AGENTS.md"; do
    if [[ -f "$cand" && -r "$cand" ]]; then
      global_agents="$cand"
      break
    fi
  done

  for cand in "${repo_root}/AGENTS.md" "${repo_root}/.agents/AGENTS.md" "${repo_root}/CLAUDE.md"; do
    if [[ -f "$cand" && -r "$cand" ]]; then
      [[ "$cand:A" != "$global_agents:A" ]] && project_agents="$cand"
      break
    fi
  done

  local os_name arch_name current_date git_branch
  os_name="$(uname -s)"
  arch_name="$(uname -m)"
  current_date="$(date)"
  git_branch="$(git rev-parse --abbrev-ref HEAD 2>/dev/null)" || git_branch="none"

  local -a tool_lines
  local tname tfn tdesc
  for tname in ${=$(_zshai_tools list 2>/dev/null || echo "bash read write edit websearch")}; do
    tfn="_zshai_tool_${tname}"
    if (($+functions[$tfn])); then
      tdesc="$($tfn describe 2>/dev/null)"
      [[ -n "$tdesc" ]] && tool_lines+=("$tdesc")
    fi
  done

  local ws_guideline=""
  [[ " ${tool_lines[*]} " == *"- websearch:"* ]] && ws_guideline=$'\n'"- Use websearch to search for external documentation, libraries, APIs, or current facts"
  local tools_block="${(F)tool_lines}"

  cat <<EOF
You are an expert coding assistant operating inside zshai, a lightweight AI agent harness in Zsh. You help users by reading files, executing commands, editing code, and writing new files.

Available tools:
${tools_block}
Guidelines:
- Commands run directly in the working directory; do not prefix commands with cd
- Use read to examine files instead of cat or sed
- Use edit for precise changes; old_text must match exactly and uniquely in the file
- Use write only for new files or complete rewrites${ws_guideline}
- When the user asks conversational questions, greetings, or asks what you can do, respond directly with text describing your capabilities without calling any tools
- When an action on the workspace is requested, execute the necessary tool directly one step at a time
- Be concise and clear in your responses

Current environment:
- Working directory: ${PWD}
- Repository root: ${repo_root}
- Git branch: ${git_branch}
- Platform: ${os_name} (${arch_name})
- Date: ${current_date}
EOF

  _zshai_context_instructions "$global_agents" "$project_agents" "$repo_root"
}

_zshai_context "$@"
