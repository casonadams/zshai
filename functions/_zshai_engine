_zshai_engine_normalize_tool_calls() {
  local tc="$1"
  [[ -z "$tc" || "$tc" == "[]" || "$tc" == "null" ]] && return 0

  print -r -- "$tc" | jq -c '
    map(
      (if .function.name == "echo" or .function.name == "cat" or .function.name == "ls" or .function.name == "pwd" or .function.name == "grep" then
        .function.arguments = "\(.function.name) \(.function.arguments | if type == "string" then . else tojson end)" |
        .function.name = "bash"
      else . end) |
      select(.function.name == "bash" or .function.name == "read" or .function.name == "write" or .function.name == "edit" or .function.name == "websearch") |
      .function.name as $fn |
      .function.arguments = (
        (.function.arguments | if type == "string" then (fromjson? // .) else . end) |
        if type == "object" then
          tojson
        elif $fn == "bash" then
          {command: (tostring)} | tojson
        elif $fn == "read" then
          {path: (tostring)} | tojson
        elif $fn == "websearch" then
          {query: (tostring)} | tojson
        else
          tojson
        end
      )
    ) | if length > 0 then . else empty end
  ' 2>/dev/null
}

_zshai_engine_extract_tools() {
  local raw_content="$1"
  local clean_content tool_calls_json=""

  # Tier 1: Entire content is JSON object or array
  clean_content=$(print -r -- "$raw_content" | sed -E -e '/^[[:space:]]*```/d' -e 's/<\/?tool_call>//g')
  tool_calls_json=$(print -r -- "$clean_content" | jq -c '
    if type == "object" and .name and (.arguments or .parameters) then
      [{id: "call_parsed_0", type: "function", function: {name: .name, arguments: ((.arguments // .parameters) | if type == "string" then . else tojson end)}}]
    elif type == "array" and (.[0] | type == "object" and .name and (.arguments or .parameters)) then
      [range(0; length) as $i | {id: "call_parsed_\($i)", type: "function", function: {name: .[$i].name, arguments: (((.[$i].arguments // .[$i].parameters)) | if type == "string" then . else tojson end)}}]
    else
      empty
    end
  ' 2>/dev/null | jq -s -c 'add // empty' 2>/dev/null)

  # Tier 2: Embedded JSON blocks inside markdown fences or text
  if [[ -z "$tool_calls_json" || "$tool_calls_json" == "[]" || "$tool_calls_json" == "null" ]]; then
    tool_calls_json=""
    local block_tools
    block_tools=$(print -r -- "$raw_content" | awk '
BEGIN { in_fence = 0; brace_depth = 0; buf = ""; }
/```/ {
  if (in_fence) {
    if (length(buf) > 0) { print buf; print "---TOOL_SEP---"; buf = ""; }
    in_fence = 0;
  } else { in_fence = 1; }
  next;
}
in_fence { buf = buf (length(buf) > 0 ? "\n" : "") $0; next; }
!in_fence {
  line = $0;
  n_open = gsub(/\{/, "{", line);
  n_close = gsub(/\}/, "}", line);
  if (brace_depth == 0 && n_open > 0) {
    idx = index($0, "{"); buf = substr($0, idx); brace_depth = n_open - n_close;
  } else if (brace_depth > 0) {
    buf = buf "\n" $0; brace_depth += n_open - n_close;
  }
  if (brace_depth <= 0 && length(buf) > 0) {
    if (index(buf, "\"name\"") > 0 && (index(buf, "\"arguments\"") > 0 || index(buf, "\"parameters\"") > 0)) {
      print buf; print "---TOOL_SEP---";
    }
    buf = ""; brace_depth = 0;
  }
}')
    if [[ -n "$block_tools" ]]; then
      tool_calls_json=$(print -r -- "$block_tools" | jq -R -s -c '
        [split("---TOOL_SEP---")[] |
         sub("^\\s+"; "") | sub("\\s+$"; "") |
         select(length > 0) |
         fromjson? |
         select(type == "object" and .name and (.arguments or .parameters))] |
        if length > 0 then
          [range(0; length) as $i | {
            id: "call_parsed_\($i)",
            type: "function",
            function: {
              name: .[$i].name,
              arguments: ((.[$i].arguments // .[$i].parameters) | if type == "string" then . else tojson end)
            }
          }]
        else
          empty
        end
      ' 2>/dev/null)
    fi
  fi

  # Tier 3: Standalone ```bash / ```sh code blocks
  if [[ -z "$tool_calls_json" || "$tool_calls_json" == "[]" || "$tool_calls_json" == "null" ]]; then
    tool_calls_json=""
    local bash_block
    bash_block=$(print -r -- "$raw_content" | awk '
BEGIN { in_b = 0; cmd = ""; }
/^[[:space:]]*```(bash|sh|zsh)[[:space:]]*$/ { in_b = 1; cmd = ""; next; }
/^[[:space:]]*```[[:space:]]*$/ {
  if (in_b && length(cmd) > 0) {
    sub(/^[[:space:]]+/, "", cmd);
    sub(/[[:space:]]+$/, "", cmd);
    print cmd;
  }
  in_b = 0; next;
}
in_b { cmd = cmd (length(cmd) > 0 ? "\n" : "") $0; }
')
    if [[ -n "$bash_block" ]]; then
      tool_calls_json=$(jq -n --arg cmd "$bash_block" '[{
        id: "call_auto_bash_0",
        type: "function",
        function: {
          name: "bash",
          arguments: {command: $cmd} | tojson
        }
      }]')
    fi
  fi

  _zshai_engine_normalize_tool_calls "$tool_calls_json"
}

_zshai_engine_rtk_rewrite() {
  local tool_args="$1"
  if [[ "${ZSHAI_RTK:-}" != "1" && "${ZSHAI_RTK:-}" != "auto" ]] || ! (($+commands[rtk])); then
    print -r -- "$tool_args"
    return 0
  fi
  local cmd rewritten rtk_ret
  cmd=$(print -r -- "$tool_args" | jq -r '.command // empty' 2>/dev/null || echo "$tool_args")
  if [[ -n "$cmd" && "$cmd" != rtk\ * ]]; then
    rewritten=$(rtk rewrite "$cmd" 2>/dev/null)
    rtk_ret=$?
    if ((rtk_ret == 0 || rtk_ret == 3)) && [[ -n "$rewritten" && "$rewritten" != "$cmd" ]]; then
      jq -c -n --arg cmd "$rewritten" '{command: $cmd}' 2>/dev/null && return 0
    fi
  fi
  print -r -- "$tool_args"
}

_zshai_engine_exec_calls() {
  local tool_calls_json="$1" quiet="${2:-0}" current_step="${3:-0}"
  local tool_id="" tool_name="" tool_args="" norm_args="" tool_output=""
  local hook_payload="" hook_res="" hook_action="" reason="" result_payload=""
  local num_calls=0 i=0 args_rewritten=0
  num_calls=$(print -r -- "$tool_calls_json" | jq -r 'length')

  for ((i = 0; i < num_calls; i++)); do
    tool_id=$(print -r -- "$tool_calls_json" | jq -r ".[$i].id")
    tool_name=$(print -r -- "$tool_calls_json" | jq -r ".[$i].function.name")
    tool_args=$(print -r -- "$tool_calls_json" | jq -r ".[$i].function.arguments | if type == \"string\" then . else tojson end")
    args_rewritten=0
    tool_output=""

    hook_payload=$(jq -n \
      --arg event "tool_call" \
      --arg tool_name "$tool_name" \
      --argjson tool_args "$tool_args" \
      --argjson step "$current_step" \
      '{event: $event, tool_name: $tool_name, tool_args: $tool_args, step: $step}' 2>/dev/null ||
      jq -n \
        --arg event "tool_call" \
        --arg tool_name "$tool_name" \
        --arg tool_args "$tool_args" \
        --argjson step "$current_step" \
        '{event: $event, tool_name: $tool_name, tool_args: $tool_args, step: $step}' 2>/dev/null)

    hook_res=$(_zshai_hook "tool_call" "$hook_payload")
    hook_action=$(print -r -- "$hook_res" | jq -r '.action // empty' 2>/dev/null)
    if [[ "$hook_action" == "rewrite_args" ]]; then
      tool_args=$(print -r -- "$hook_res" | jq -c '.args | if type == "string" then (fromjson? // .) else . end' 2>/dev/null)
      args_rewritten=1
    elif [[ "$hook_action" == "skip" ]]; then
      reason=$(print -r -- "$hook_res" | jq -r '.reason // "by hook"' 2>/dev/null)
      tool_output="[Tool execution skipped: ${reason}]"
      ((quiet == 0)) && print -u2 -P -- "%F{yellow}[Tool execution skipped: ${reason}]%f"
    elif [[ "$hook_action" == "stop" ]]; then
      reason=$(print -r -- "$hook_res" | jq -r '.reason // "by hook"' 2>/dev/null)
      tool_output="[Tool execution stopped: ${reason}]"
      ((quiet == 0)) && print -u2 -P -- "%F{yellow}[Tool execution stopped: ${reason}]%f"
      transcript=$(print -r -- "$transcript" | jq \
        --arg id "$tool_id" \
        --arg name "$tool_name" \
        --arg content "$tool_output" \
        '. + [{"role": "tool", "tool_call_id": $id, "name": $name, "content": $content}]')
      break
    fi

    if [[ -z "$tool_output" ]]; then
      if [[ "$tool_name" == "bash" && "$args_rewritten" -eq 0 ]]; then
        tool_args=$(_zshai_engine_rtk_rewrite "$tool_args")
      fi

      norm_args=$(print -r -- "$tool_args" | jq -c -S . 2>/dev/null || echo "$tool_args")
      if [[ "$tool_name" == "$last_tool" && "$norm_args" == "$last_args" ]]; then
        ((repeat_count++))
      else
        last_tool="$tool_name"
        last_args="$norm_args"
        repeat_count=1
      fi

      if ((repeat_count >= 3)); then
        tool_output="Repetition guard: tool '$tool_name' called 3 times consecutively with identical arguments. Stop repeating and adjust your strategy."
        ((quiet == 0)) && print -u2 -P -- "%F{yellow}[Repetition guard triggered: tool '$tool_name' repeated 3 times]%f"
      else
        ((quiet == 0)) && print -u2 -P -- "%F{cyan}▶ ${tool_name}%f %F{242}${tool_args}%f"
        tool_output="$(_zshai_tools exec "$tool_name" "$tool_args")"
        result_payload=$(jq -n \
          --arg event "tool_result" \
          --arg tool_name "$tool_name" \
          --argjson tool_args "$tool_args" \
          --arg output "$tool_output" \
          --argjson step "$current_step" \
          '{event: $event, tool_name: $tool_name, tool_args: $tool_args, output: $output, step: $step}' 2>/dev/null ||
          jq -n \
            --arg event "tool_result" \
            --arg tool_name "$tool_name" \
            --arg tool_args "$tool_args" \
            --arg output "$tool_output" \
            --argjson step "$current_step" \
            '{event: $event, tool_name: $tool_name, tool_args: $tool_args, output: $output, step: $step}' 2>/dev/null)
        hook_res=$(_zshai_hook "tool_result" "$result_payload")
        hook_action=$(print -r -- "$hook_res" | jq -r '.action // empty' 2>/dev/null)
        if [[ "$hook_action" == "rewrite_result" ]]; then
          tool_output=$(print -r -- "$hook_res" | jq -r '.result // empty' 2>/dev/null)
        fi
      fi
    fi

    transcript=$(print -r -- "$transcript" | jq \
      --arg id "$tool_id" \
      --arg name "$tool_name" \
      --arg content "$tool_output" \
      '. + [{"role": "tool", "tool_call_id": $id, "name": $name, "content": $content}]')
  done
}

_zshai_render_markdown() {
  local content="$1"
  if [[ -t 1 && "${ZSHAI_RENDER:-1}" != "0" ]]; then
    if (($+commands[glow])); then
      print -r -- "$content" | glow -s dark -
      return $?
    elif (($+commands[mdcat])); then
      print -r -- "$content" | mdcat -
      return $?
    fi
  fi
  print -r -- "$content"
}

_zshai_engine_init_transcript() {
  local prompt="$1" prev="$2"
  if [[ -z "$prev" || "$prev" == "[]" ]]; then
    local sys="$(_zshai_context)"
    jq -n --arg sys "$sys" --arg user "$prompt" '[{"role": "system", "content": $sys}, {"role": "user", "content": $user}]'
  else
    if [[ -n "$prompt" ]]; then
      print -r -- "$prev" | jq --arg user "$prompt" '. + [{"role": "user", "content": $user}]'
    else
      print -r -- "$prev"
    fi
  fi
}

_zshai_engine() {
  autoload -Uz _zshai_config _zshai_config_get _zshai_context _zshai_hook _zshai_prune _zshai_tools _zshai_provider 2>/dev/null

  local user_prompt="" transcript="" step_limit=""
  local enable_tools=1 quiet=0 verbose=0

  while (($# > 0)); do
    case "$1" in
      --history)
        shift
        transcript="$1"
        ;;
      -s | --step-limit)
        shift
        step_limit="$1"
        ;;
      --no-tools) enable_tools=0 ;;
      -q | --quiet) quiet=1 ;;
      -v | --verbose) verbose=1 ;;
      *) user_prompt="${user_prompt:+$user_prompt }$1" ;;
    esac
    shift
  done

  if [[ -z "$user_prompt" && -z "$transcript" ]]; then
    print -u2 -- "Error: user prompt is required"
    return 1
  fi

  local max_steps="${step_limit:-$(_zshai_config_get max_steps)}"
  transcript=$(_zshai_engine_init_transcript "$user_prompt" "$transcript")

  local tools_json="[]"
  ((enable_tools == 1)) && tools_json="$(_zshai_tools definitions)"

  typeset -g last_tool="" last_args="" repeat_count=0
  local step=0 response="" prov_status=0 reasoning=""
  local tool_calls_json="" raw_content="" final_content="" assistant_msg="" was_streamed=""

  while true; do
    if ((max_steps > 0 && step >= max_steps)); then
      print -u2 -- "Reached maximum steps limit ($max_steps). Stopping."
      typeset -g ZSHAI_LAST_HISTORY="$transcript"
      return 1
    fi

    transcript=$(_zshai_prune "$transcript")
    response="$(_zshai_provider call "$transcript" "$tools_json")"
    prov_status=$?
    if ((prov_status != 0)) || [[ -z "$response" ]]; then
      print -u2 -- "Error: failed to get response from provider"
      typeset -g ZSHAI_LAST_HISTORY="$transcript"
      return 1
    fi

    reasoning=$(print -r -- "$response" | jq -r '.choices[0].message.reasoning_content // empty' 2>/dev/null)
    [[ -n "$reasoning" && $quiet -eq 0 ]] && print -u2 -P -- "%F{242}${reasoning}%f"

    tool_calls_json=""
    if ((enable_tools == 1)); then
      tool_calls_json=$(print -r -- "$response" | jq -c '.choices[0].message.tool_calls | select(. != null and length > 0)' 2>/dev/null)
      if [[ -z "$tool_calls_json" ]]; then
        raw_content=$(print -r -- "$response" | jq -r '.choices[0].message.content // empty' 2>/dev/null)
        [[ -n "$raw_content" ]] && tool_calls_json=$(_zshai_engine_extract_tools "$raw_content")
      fi
      [[ -n "$tool_calls_json" ]] && tool_calls_json=$(_zshai_engine_normalize_tool_calls "$tool_calls_json")
    fi

    if [[ -z "$tool_calls_json" || "$tool_calls_json" == "[]" || "$tool_calls_json" == "null" ]]; then
      final_content="${raw_content:-$(print -r -- "$response" | jq -r '.choices[0].message.content // empty' 2>/dev/null)}"
      assistant_msg=$(print -r -- "$response" | jq '.choices[0].message')
      transcript=$(print -r -- "$transcript" | jq --argjson msg "$assistant_msg" '. + [$msg]')
      typeset -g ZSHAI_LAST_HISTORY="$transcript"
      was_streamed=$(print -r -- "$response" | jq -r '.streamed // false' 2>/dev/null)
      [[ "$was_streamed" == "true" ]] && print -u2 "" || _zshai_render_markdown "$final_content"
      return 0
    fi

    assistant_msg=$(jq -n --argjson tc "$tool_calls_json" '{role: "assistant", tool_calls: $tc}')
    transcript=$(print -r -- "$transcript" | jq --argjson msg "$assistant_msg" '. + [$msg]')

    _zshai_engine_exec_calls "$tool_calls_json" "$quiet" "$step"

    ((step++))
  done
}

_zshai_engine "$@"
